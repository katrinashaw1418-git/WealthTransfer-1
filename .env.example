# REQUIRED — server will not start without these
DATABASE_URL=
JWT_SECRET=

# REQUIRED FOR PRODUCTION — go-no-go will fail without these
NODE_ENV=production
LOG_DIR=
OPERATOR_ALERT_WEBHOOK_URL=
DB_BACKUP_DIR=

# PLATFORM IDENTITY — required for fee/ledger credit leg
PLATFORM_USER_ID=

# SECURITY — lock down metrics endpoint
METRICS_TOKEN=
METRICS_ALLOW_FROM=

# KYC — required when Sumsub is live
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=
SUMSUB_LEVEL_NAME=

# EMAIL NOTIFICATIONS
GMAIL_USER=
GMAIL_APP_PASSWORD=
APP_BASE_URL=

# OPTIONAL — local dev only
APP_ENV=
ALLOW_LOCAL_DEV_AUTH=

# OPTIONAL — alerting tuning
OPERATOR_ALERT_WEBHOOK_URL_BACKUP=
OPERATOR_ALERT_DEDUPE_WINDOW_MIN=

# OPTIONAL — cron toggles
NIGHTLY_GO_NO_GO_DISABLED=
FEE_RULES_CONSENT_RECONCILE_CRON_ENABLED=
